# Supabase (client-side, safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server-side only — Vercel serverless functions in /api)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email
RESEND_API_KEY=

# Anthropic — AI document generation, and Claude for AI answers to customers (api/_aiReply.js)
ANTHROPIC_API_KEY=

# AI answers to customers' questions on every channel and on calls (api/_aiReply.js).
# Nothing is called until NOVA_AI_REPLIES=on, a business switches AI answers on, and spending
# is switched on with a monthly cap. Any one key is enough; the others are fallbacks.
NOVA_AI_REPLIES=
# anthropic | openai | google — used when a business has not chosen one
NOVA_AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (defaults: claude-haiku-5-5, gpt-6-luna, gemini-3.5-flash-lite)
NOVA_AI_MODEL_ANTHROPIC=
NOVA_AI_MODEL_OPENAI=
NOVA_AI_MODEL_GOOGLE=

# Google Cloud / Google Maps Platform
GOOGLE_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Nova AI — voice + SMS agent platform (/ai)
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ISAAC_ALERT_PHONE=
DEEPGRAM_API_KEY=
# wss:// URL of the separately-hosted media-stream service (see api/nova-ai/stream.js —
# Vercel serverless functions cannot hold open the WebSocket a live call needs).
NOVA_AI_STREAM_WS_URL=

# Cal.com — booking link
VITE_CALCOM_URL=
