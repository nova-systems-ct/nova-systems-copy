{
  "rewrites": [
    {
      "source": "/webhooks/twilio-message",
      "destination": "/api/client?resource=company&op=twilio-message"
    },
    {
      "source": "/webhooks/twilio-status",
      "destination": "/api/client?resource=company&op=twilio-status"
    },
    {
      "source": "/webhooks/voice-agent",
      "destination": "/api/client?resource=company&op=voice-agent"
    },
    {
      "source": "/webhooks/apple-messages",
      "destination": "/api/stripe?action=channel-webhook&channel=apple_messages"
    },
    {
      "source": "/webhooks/instagram",
      "destination": "/api/stripe?action=channel-webhook&channel=instagram"
    },
    {
      "source": "/service-request",
      "destination": "/sms-program/index.html"
    },
    {
      "source": "/service-texts/privacy",
      "destination": "/sms-program/privacy.html"
    },
    {
      "source": "/service-texts/terms",
      "destination": "/sms-program/terms.html"
    },
    {
      "source": "/service-texts/consent-proof-2026-11-08.jpg",
      "destination": "/sms-program/consent-proof-2026-11-08.jpg"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/wallet/nova-setup-test.pkpass",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.apple.pkpass"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=nova-setup-test.pkpass"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://xizmgruvuazmummotzkp.supabase.co https://api.resend.com https://api.anthropic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; connect-src 'self' https://huggingface.co https://us.aws.cdn.hf.co https://cas-bridge.xethub.hf.co https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.hf.co https://xizmgruvuazmummotzkp.supabase.co https://api.resend.com https://api.anthropic.com https://api.stripe.com; worker-src 'self' blob:; media-src 'self' blob:;"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/client.js": {
      "maxDuration": 60
    },
    "api/stripe.js": {
      "maxDuration": 60
    }
  }
}
